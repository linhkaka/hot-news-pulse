# Copy file này thành .env rồi điền thông tin. KHÔNG chia sẻ file .env cho ai.
# Bắt buộc: Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-TOKEN-TU-BOTFATHER
TELEGRAM_CHAT_ID=123456789

# ---- YouTube ----
# Không bắt buộc. Bỏ trống = dùng RSS miễn phí (chỉ thêm kênh bằng ID UC...).
# Có key = số view mới hơn + thêm kênh bằng @handle.
YOUTUBE_API_KEY=
# Kênh cần theo dõi, cách nhau dấu phẩy (hoặc thêm sau bằng /addyt trong Telegram)
YT_CHANNELS=
YOUTUBE_POLL_INTERVAL_SECONDS=60

# ---- Facebook Reels (bỏ trống nếu không dùng) ----
FB_USER_ACCESS_TOKEN=
# Page ID cách nhau dấu phẩy (hoặc gõ /addall trong Telegram để thêm tất cả Page bạn quản lý)
FB_PAGE_IDS=
POLL_INTERVAL_SECONDS=60

# Ngưỡng view chung cho cả Facebook và YouTube
VIEW_THRESHOLD=5000
# Số Page/kênh quét song song
WORKERS=5
