# Copy file này thành .env rồi điền thông tin. KHÔNG chia sẻ file .env cho ai.
# Bắt buộc: Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-TOKEN-TU-BOTFATHER
TELEGRAM_CHAT_ID=123456789

# ---- YouTube (bỏ trống nếu không dùng) ----
YOUTUBE_API_KEY=
# Kênh cần theo dõi: @handle, ID kênh (UC...) hoặc link kênh, cách nhau dấu phẩy
# (hoặc thêm sau bằng lệnh /addyt trong Telegram)
YT_CHANNELS=
YOUTUBE_POLL_INTERVAL_SECONDS=300

# ---- Facebook Reels (bỏ trống nếu không dùng) ----
FB_USER_ACCESS_TOKEN=
# Page ID cách nhau dấu phẩy (hoặc thêm sau bằng lệnh /add trong Telegram)
FB_PAGE_IDS=
POLL_INTERVAL_SECONDS=120

# Ngưỡng view chung cho cả Facebook và YouTube
VIEW_THRESHOLD=5000
