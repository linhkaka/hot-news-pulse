{
  "manifest_version": 3,
  "name": "SNAKEMEDIA POD",
  "short_name": "SNAKEMEDIA",
  "version": "1.0.0",
  "description": "Soi sản phẩm POD win từ Thư viện quảng cáo Facebook và video viral TikTok / Reels. Luật rõ ràng, không điểm AI.",
  "minimum_chrome_version": "116",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {
    "default_title": "SNAKEMEDIA POD",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}
  },
  "background": {"service_worker": "sw.js", "type": "module"},
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "tabs", "scripting", "webNavigation"],
  "host_permissions": ["<all_urls>"]
}
