# ============================================================================
# RICHTUBE Engine - cấu hình. Copy file này thành ".env" rồi điền giá trị.
# ============================================================================

# --- Bắt buộc ---
# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials)
YOUTUBE_API_KEY=
# Một hoặc nhiều Gemini API key, ngăn cách bằng dấu phẩy (hệ thống tự xoay vòng khi hết quota)
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# true = cho Gemini "xem" trực tiếp 2 phút đầu video để mổ xẻ hook (tốn token hơn)
GEMINI_WATCH_VIDEO=true

# --- Ngôn ngữ đầu ra ---
TITLE_LANGUAGE=English
SCRIPT_LANGUAGE=Tiếng Việt

# --- Telegram (tuỳ chọn) ---
TELEGRAM_BOT_TOKEN=
# Chat nhận thông báo mặc định
TELEGRAM_CHAT_ID=
# Các chat được phép ra lệnh cho Bot, ngăn cách bằng dấu phẩy (để trống = chỉ TELEGRAM_CHAT_ID)
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Lark Base (tuỳ chọn) ---
LARK_DOMAIN=https://open.larksuite.com
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_APP_TOKEN=
LARK_TABLE_ID=

# --- Bảo mật & mạng ---
# Nếu đặt, mọi lệnh POST phải gửi kèm header X-API-Key (Web và Bot tự gửi)
RICHTUBE_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Khác ---
DATA_DIR=data
# Số video tốt nhất được mổ xẻ sâu sau mỗi lệnh Tìm Kênh Đa Quốc Gia
DISCOVER_ANALYZE_TOP=3

# --- Radar 24/7 (tự quét các kênh trong danh sách theo dõi) ---
# Bao nhiêu giờ quét 1 lần (0 = tắt quét tự động)
RADAR_INTERVAL_HOURS=6
# Chỉ mổ xẻ video có TAE từ mức này trở lên
RADAR_MIN_TAE=3.0
# Chỉ xét video đăng trong vòng N giờ gần đây
RADAR_MAX_AGE_HOURS=72
# Tối đa bao nhiêu video được mổ xẻ mỗi lượt quét (tiết kiệm quota Gemini)
RADAR_MAX_ANALYZE=3
